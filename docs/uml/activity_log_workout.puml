@startuml activity_log_workout
title FitTrack — Activity Diagram: Record a Workout

|User|
start
:Open app;
|App|
if (Profile saved?) then (no)
  repeat
    |User|
    :Answer assessment: gender, age (wheel),\nweight & height (rulers), level (gauge), goal;
    |App|
    :Pickers clamp to valid ranges;\nvalidate on save;
  repeat while (All values valid?) is (no / show inline error)
  ->yes;
  :Compute BMI, BMR, TDEE,\nrecommended calorie target;
  :Save profile;
else (yes)
endif

|User|
:Tap "Start workout";
|App|
:Create WorkoutSession(body weight)\nstate = IN_PROGRESS, start timer;

repeat
  |User|
  :Select exercise\n(search + Strength/Cardio filter);
  if (Category?) then (strength)
    :Set reps and weight\nwith steppers;
  else (cardio)
    :Set minutes with stepper;
  endif
  |App|
  if (Input valid?) then (yes)
    :Add set / minutes to ExerciseEntry;
    fork
      :Recalculate total reps\nand volume;
    fork again
      :Recalculate calories\n(MET x 3.5 x kg / 200 x min);
    fork again
      :Update est. 1RM\n(if load > 0, reps <= 12);
    end fork
    :Refresh totals on screen;
  else (no)
    :Show error banner\nnext to Log button;
  endif
  |User|
  if (Logged by mistake?) then (yes)
    :Tap Undo;
    |App|
    :Remove last set / block,\nrecalculate totals;
  else (no)
  endif
  |User|
  if (Need a break?) then (yes)
    :Tap Pause;
    |App|
    :Stop timer (state = PAUSED);
    |User|
    :Tap Resume;
    |App|
    :Restart timer (state = IN_PROGRESS);
  else (no)
  endif
  |User|
repeat while (More exercises?) is (yes)
->no;

if (Finish or Cancel?) then (Cancel)
  |App|
  :Ask for confirmation;
  if (Discard?) then (yes)
    :state = CANCELLED;
    stop
  else (no)
    :Return to logging;
    detach
  endif
else (Finish)
  |App|
  :Show summary sheet\n(reps, kcal, time);
  |User|
  if (Finish & save?) then (Keep going)
    detach
  else (confirm)
  endif
  |App|
  if (At least one set or\ncardio block logged?) then (no)
    :Show "Log at least one set";
    detach
  else (yes)
    :state = COMPLETED\nbuild WorkoutSummary;
    :Save summary to device storage;
    :Show totals, history updated;
  endif
endif
stop
@enduml
