@startuml class
title FitTrack — Class Diagram (React Native / TypeScript)
skinparam classAttributeIconSize 0
hide empty members

package "src/domain (pure TypeScript — unit tested)" {
  enum Sex {
    male
    female
  }
  enum ActivityLevel {
    sedentary
    light
    moderate
    active
    very_active
  }
  enum FitnessGoal {
    lose_weight
    build_muscle
    keep_fit
    endurance
  }
  enum ExerciseCategory {
    strength
    cardio
  }
  enum SessionState {
    not_started
    in_progress
    paused
    completed
    cancelled
  }

  class UserProfile <<immutable>> {
    + name : string
    + age : number  (13-100)
    + sex : Sex
    + weightKg : number  (20-300)
    + heightCm : number  (100-250)
    + activityLevel : ActivityLevel
    + goal : FitnessGoal
    + dailyCalorieGoal : number
    + dailyBurnGoal : number
  }

  class Exercise <<immutable>> {
    + id : string
    + name : string
    + category : ExerciseCategory
    + met : number
    + muscle : string
  }

  class WorkoutSet <<immutable>> {
    + reps : number  (1-100)
    + weightKg : number  (0-500)
  }

  class ExerciseEntry {
    + sets : WorkoutSet[]  (max 20)
    + cardioBlocks : number[]  (total max 600)
    + addSet(s : WorkoutSet)
    + addMinutes(m : number)
    + removeLast() : boolean
    + totalReps() : number
    + volume() : number
    + calories(bodyKg : number) : number
    + bestOneRepMax() : number | null
  }

  class WorkoutSession {
    + id : string
    + state : SessionState
    + bodyWeightKg : number
    - activeMs : number
    - undoStack : string[]
    + start()
    + pause()
    + resume()
    + finish() : WorkoutSummary
    + cancel()
    + logSet(e : Exercise, reps, kg) : WorkoutSet
    + logCardio(e : Exercise, minutes)
    + undoLast() : boolean
    + activeMinutes : number
    + totalReps() : number
    + totalVolume() : number
    + totalCalories() : number
  }

  class WorkoutSummary <<immutable>> {
    + id : string
    + dateIso : string
    + activeMinutes : number
    + totalReps : number
    + totalVolumeKg : number
    + caloriesKcal : number
    + exercises : string[]
  }

  class FitnessCalculator <<module calculations.ts>> {
    + {static} bmi(kg, cm) : number
    + {static} bmiCategory(bmi) : string
    + {static} bmr(kg, cm, age, sex) : number
    + {static} tdee(bmr, level) : number
    + {static} recommendedIntake(tdee, goal, sex) : number
    + {static} caloriesBurned(met, kg, min) : number
    + {static} strengthCalories(sets, met, kg) : number
    + {static} totalReps(sets) : number
    + {static} trainingVolume(sets) : number
    + {static} oneRepMaxEpley(kg, reps) : number
    + {static} oneRepMaxBrzycki(kg, reps) : number
    + {static} calorieBalance(in, tdee, ex) : number
    + {static} progressPercent(cur, goal) : number
  }

  class Validator <<module validation.ts>> {
    + {static} check(value, range) : number
    + {static} parse(text, range) : number
    + {static} clamp(value, range) : number
  }
  class Range <<immutable>> {
    + name : string
    + min : number
    + max : number
    + integer : boolean
  }

  class ProfileFactory <<module models.ts>> {
    + {static} createProfile(input) : UserProfile
    + {static} profileMetrics(p) : ProfileMetrics
    + {static} createSet(reps, kg) : WorkoutSet
  }

  class Stats <<module stats.ts>> {
    + {static} today(history, now) : DayTotal
    + {static} lastDays(history, now, n) : DayTotal[]
    + {static} streak(history, now) : number
    + {static} totals(history) : Totals
  }

  interface KeyValueStore {
    + getItem(key) : Promise<string | null>
    + setItem(key, value) : Promise<void>
    + removeItem(key) : Promise<void>
  }

  class Repository {
    + saveProfile(p : UserProfile)
    + loadProfile() : UserProfile | null
    + addWorkout(s : WorkoutSummary)
    + listWorkouts() : WorkoutSummary[]
    + clearAll()
  }
  class MemoryStore
}

package "src/store + src/app (React Native UI)" {
  class AppStore <<React context>> {
    + profile : UserProfile | null
    + history : WorkoutSummary[]
    + session : WorkoutSession | null
    + draft : Draft
    + saveProfile(p)
    + startSession() : WorkoutSession
    + mutate(fn)
    + finishSession() : WorkoutSummary
    + cancelSession()
    + resetAll()
  }
  class OnboardingScreens <<routes /onboarding/*>>
  class HomeScreen <<route /(tabs)>>
  class WorkoutScreen <<route /(tabs)/workout>>
  class HistoryScreen <<route /(tabs)/history>>
  class ProfileScreen <<route /(tabs)/profile>>
  class ExercisePicker <<route /exercise-picker>>
  class AsyncStorage <<library>>
}

UserProfile --> Sex
UserProfile --> ActivityLevel
UserProfile --> FitnessGoal
Exercise --> ExerciseCategory
WorkoutSession --> SessionState
WorkoutSession "1" *-- "0..*" ExerciseEntry
ExerciseEntry "1" *-- "0..20" WorkoutSet
ExerciseEntry "0..*" --> "1" Exercise
WorkoutSession ..> WorkoutSummary : <<create>>
ExerciseEntry ..> FitnessCalculator : uses
ProfileFactory ..> FitnessCalculator : uses
ProfileFactory ..> UserProfile : <<create>>
FitnessCalculator ..> Validator : uses
Validator ..> Range
Stats ..> WorkoutSummary
Repository o-- KeyValueStore
MemoryStore ..|> KeyValueStore
AsyncStorage ..|> KeyValueStore
Repository ..> UserProfile : persists
Repository ..> WorkoutSummary : persists

AppStore o-- Repository
AppStore o-- "0..1" WorkoutSession
OnboardingScreens ..> AppStore
HomeScreen ..> AppStore
HomeScreen ..> Stats
WorkoutScreen ..> AppStore
HistoryScreen ..> AppStore
ProfileScreen ..> AppStore
ExercisePicker ..> AppStore
@enduml
